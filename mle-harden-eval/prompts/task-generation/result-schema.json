{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {"type": "string", "enum": ["success", "no_viable_task"]},
    "summary": {"type": "string", "minLength": 1},
    "slug": {"type": ["string", "null"]},
    "title": {"type": ["string", "null"]},
    "proposed_goal": {"type": ["string", "null"]},
    "goal_signature": {"type": ["string", "null"]},
    "category": {"type": ["string", "null"], "minLength": 1},
    "metric_name": {"type": ["string", "null"]},
    "metric_direction": {"type": ["string", "null"], "enum": ["higher", "lower", null]},
    "reproducibility_tolerance": {"type": ["number", "null"], "minimum": 0},
    "proposed_baseline": {"type": ["number", "null"]},
    "proposed_bronze": {"type": ["number", "null"]},
    "proposed_silver": {"type": ["number", "null"]},
    "proposed_gold": {"type": ["number", "null"]},
    "cpu_cores": {"type": ["integer", "null"], "minimum": 1},
    "ram_bytes": {"type": ["integer", "null"], "minimum": 1},
    "disk_bytes": {"type": ["integer", "null"], "minimum": 1},
    "gpu_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 1},
    "gpu_memory_bytes": {"type": ["integer", "null"], "minimum": 0},
    "wall_clock_seconds": {"type": ["integer", "null"], "minimum": 600, "maximum": 3600},
    "data_loader_workers": {"type": ["integer", "null"], "minimum": 0},
    "scratch_bytes": {"type": ["integer", "null"], "minimum": 1},
    "description_path": {"type": ["string", "null"]},
    "public_dir": {"type": ["string", "null"]},
    "private_dir": {"type": ["string", "null"]},
    "solution_path": {"type": ["string", "null"]},
    "solution_readme_path": {"type": ["string", "null"]},
    "generation_evidence_path": {"type": "string", "minLength": 1},
    "validation_evidence_path": {"type": ["string", "null"]},
    "benchmark_evidence_path": {"type": ["string", "null"]}
  },
  "required": [
    "status",
    "summary",
    "slug",
    "title",
    "proposed_goal",
    "goal_signature",
    "category",
    "metric_name",
    "metric_direction",
    "reproducibility_tolerance",
    "proposed_baseline",
    "proposed_bronze",
    "proposed_silver",
    "proposed_gold",
    "cpu_cores",
    "ram_bytes",
    "disk_bytes",
    "gpu_count",
    "gpu_memory_bytes",
    "wall_clock_seconds",
    "data_loader_workers",
    "scratch_bytes",
    "description_path",
    "public_dir",
    "private_dir",
    "solution_path",
    "solution_readme_path",
    "generation_evidence_path",
    "validation_evidence_path",
    "benchmark_evidence_path"
  ]
}
